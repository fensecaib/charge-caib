* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Keep source and build metadata stable across Windows/macOS/Linux.
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# Binary artifacts required by the project.
*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
